PORT=5000

# --- Option 1: Neon (or any hosted Postgres) ---
# Paste your full connection string from the Neon dashboard here.
# When DATABASE_URL is set, the DB_* vars below are ignored.
DATABASE_URL=

# --- Option 2: local PostgreSQL (only used if DATABASE_URL above is empty) ---
DB_NAME=medical_management
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
